{
  "discordToken": "PASTE_DISCORD_BOT_TOKEN",
  "commandPrefix": "!codex",
  "channelAllowlist": ["CHANNEL_ID_1"],
  "allowedUserIds": ["USER_ID_1"],
  "allowedRoleIds": ["ROLE_ID_1"],
  "codexSessionId": "last",
  "codexCwd": "/path/to/workspace",
  "codexArgs": [],
  "memoryDir": "./memory",
  "memoryJsonl": "memory.jsonl",
  "memoryMarkdown": "memory.md",
  "replyOnError": true,
  "sendTyping": true,
  "immediateAck": true,
  "ackMessage": "收到",
  "logRejections": true,
  "rejectionLog": "rejections.jsonl",
  "reconnectTimeoutMs": 120000,
  "reconnectIntervalMs": 30000,
  "importantKeywords": ["记住", "记一下", "记录"],
  "importantJsonl": "important.jsonl",
  "importantMarkdown": "important.md",
  "importantReply": "已记录",
  "allowDm": true,
  "autoReplyInDm": true,
  "autoReplyInChannels": false,
  "mentionReplyInChannels": false,
  "perUserSessions": false,
  "userSessionsFile": "./memory/user_sessions.json",
  "ownerUserIds": ["OWNER_USER_ID"],
  "adminChannelId": "ADMIN_CHANNEL_ID",
  "requireOwnerApproval": true,
  "approvalsLog": "approvals.jsonl",
  "approvalUseModel": false,
  "approvalAllowlistUserIds": [],
  "approvalAllowlistRoleIds": [],
  "approvalAllowlistChannelIds": [],
  "approvalAllowlistGuildIds": [],
  "approvalAllowlistPatterns": [],
  "approvalRules": {
    "commandKeywords": [
      "ls",
      "cat",
      "rm",
      "mv",
      "cp",
      "chmod",
      "chown",
      "sudo",
      "curl",
      "wget",
      "ssh",
      "scp",
      "git",
      "docker",
      "ps",
      "kill",
      "pkill",
      "systemctl",
      "service",
      "nohup",
      "bash",
      "sh",
      "python",
      "node"
    ],
    "denyPatterns": [],
    "pathPatterns": [
      "/(^|\\s)(~\\/|\\.\\/|\\.\\.\\/|\\/|[A-Za-z]:\\\\|\\\\\\\\)/"
    ]
  },
  "useAgentsSdk": false,
  "autoTaskRouting": false,
  "taskRoutingTimeoutMs": 15000,
  "taskRoutingKeywords": [],
  "taskRoutingMinChars": 0,
  "schedulesFile": "./memory/schedules.json",
  "safetyDenylistKeywords": [],
  "safetyDenylistReject": false,
  "messageServerEnabled": false,
  "messageServerPort": 18790,
  "messageServerToken": "",
  "codexSweepIntervalMs": 10800000,
  "codexSweepMaxAgeSec": 10800,
  "agentsPython": "python3",
  "agentsScript": "agents/agents_runner.py",
  "agentsApprovalPolicy": "never",
  "agentsSandbox": "workspace-write",
  "agentsThreadsFile": "./memory/agents_threads.json",
  "agentsOpenaiApiKey": "OPENAI_API_KEY",
  "agentsOpenaiBaseUrl": "https://api.openai.com/v1",
  "agentsHttpProxy": "",
  "agentsHttpsProxy": "",
  "agentsNoProxy": "",
  "lockFile": "/tmp/codex-discord-bridge.lock",
  "registerSlashCommands": true,
  "slashGuildIds": [],
  "sessionsDir": "/path/to/.codex/sessions",
  "sessionsLimit": 10,
  "maxConcurrentRuns": 1
}
