{
  "discordToken": "PASTE_DISCORD_BOT_TOKEN",
  "ownerUserId": "OWNER_USER_ID",
  "codexCwd": "/home/cc",
  "codexCommand": "codex",
  "codexModel": "",
  "codexSandbox": "workspace-write",
  "codexApprovalPolicy": "never",
  "allowPlainTextDm": true,
  "sendTyping": true,
  "registerSlashCommands": true,
  "slashGuildIds": [],
  "streamUpdateIntervalMs": 1500,
  "ackMessage": "收到，任务已排队",
  "turnTimeoutMs": 900000,
  "requestTimeoutMs": 30000,
  "maxConcurrentTasks": 2,
  "taskThreadMode": "isolated",
  "historyDefaultLimit": 10,
  "recallDefaultLimit": 8,
  "lockFile": "/tmp/codex-discord-bridge-v2.lock",
  "dataDir": "./data",
  "logsDir": "./logs",
  "tasksFile": "./data/tasks.jsonl",
  "runtimeStateFile": "./data/runtime_state.json",
  "logFile": "./logs/bridge.log",
  "minStreamPreviewChars": 1200
}
